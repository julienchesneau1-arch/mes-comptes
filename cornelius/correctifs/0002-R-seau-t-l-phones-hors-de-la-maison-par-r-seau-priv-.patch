+test('réseau privé virtuel : un téléphone hors de la maison passe seulement si CORNELIUS_VPN est actif', async (t) => {
+  const request = {
+    url: '/api/health',
+    remoteAddress: '100.101.102.103',
+    headers: { host: '100.90.1.2:3443' },
+  };
+  const closed = await fixture(t);
+  assert.equal((await closed.inject(request)).statusCode, 403);
+  const open = await fixture(t, { vpn: true });
+  assert.equal((await open.inject(request)).statusCode, 200);
+  const outside = await open.inject({ ...request, remoteAddress: '203.0.113.9' });
+  assert.equal(outside.statusCode, 403);
+  const off = await fixture(t, { vpn: true, lan: false });
+  assert.equal((await off.inject(request)).statusCode, 403);
+});
+
