+test('réseau privé virtuel : 100.64.0.0/10 seulement sur option, jamais une adresse publique', () => {
+  for (const address of ['100.64.0.1', '100.101.102.103', '100.127.255.254', '::ffff:100.80.1.2']) {
+    assert.ok(!isPrivateAddress(address), `${address} sans option`);
+    assert.ok(isPrivateAddress(address, true), `${address} avec option`);
+  }
+  for (const address of ['100.63.255.255', '100.128.0.1', '8.8.8.8', '203.0.113.9'])
+    assert.ok(!isPrivateAddress(address, true), address);
+  assert.ok(allowedHostname('100.101.102.103', true, [], true));
+  assert.ok(!allowedHostname('100.101.102.103', true, []));
+  assert.ok(!allowedHostname('100.101.102.103', false, [], true));
+  assert.ok(allowedHostname('mac.tail1234.ts.net', true, ['mac.tail1234.ts.net'], true));
+});
+
