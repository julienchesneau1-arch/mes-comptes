diff --git a/server/network.ts b/server/network.ts
index 385c9ea..5f5f874 100644
--- a/server/network.ts
+++ b/server/network.ts
@@ -15,8 +15,10 @@ export function isLoopback(address: string | undefined): boolean {
 /**
  * Adresse du réseau local (RFC 1918, lien local, IPv6 locale unique) ou de la machine
  * elle-même. Une adresse publique n'en fait jamais partie, même si un routeur la redirige.
+ * Avec `vpn`, la plage 100.64.0.0/10 d'un réseau privé virtuel (Tailscale) compte aussi :
+ * elle n'est pas routée sur Internet et n'arrive qu'à travers le tunnel.
  */
-export function isPrivateAddress(address: string | undefined): boolean {
+export function isPrivateAddress(address: string | undefined, vpn = false): boolean {
   if (!address) return false;
   if (isLoopback(address)) return true;
   const ip = address.replace(/^::ffff:/i, '');
@@ -26,7 +28,8 @@ export function isPrivateAddress(address: string | undefined): boolean {
       a === 10 ||
       (a === 172 && b >= 16 && b <= 31) ||
       (a === 192 && b === 168) ||
-      (a === 169 && b === 254)
+      (a === 169 && b === 254) ||
+      (vpn && a === 100 && b >= 64 && b <= 127)
     );
   }
   if (isIP(ip) === 6) {
@@ -58,11 +61,16 @@ export function localAddresses(): string[] {
  * de la machine ou un nom ajouté dans CORNELIUS_ALLOWED_HOSTS. Refuser les autres noms
  * protège contre le « DNS rebinding » (un site extérieur qui se ferait passer pour Cornelius).
  */
-export function allowedHostname(hostname: string, lan: boolean, extra: readonly string[]): boolean {
+export function allowedHostname(
+  hostname: string,
+  lan: boolean,
+  extra: readonly string[],
+  vpn = false,
+): boolean {
   const host = hostname.toLowerCase().replace(/^\[|\]$/g, '');
   if (host === 'localhost' || isLoopback(host)) return true;
   if (!lan) return false;
-  if (isIP(host)) return isPrivateAddress(host);
+  if (isIP(host)) return isPrivateAddress(host, vpn);
   return (
     machineHostnames().includes(host) || extra.map((item) => item.toLowerCase()).includes(host)
   );
