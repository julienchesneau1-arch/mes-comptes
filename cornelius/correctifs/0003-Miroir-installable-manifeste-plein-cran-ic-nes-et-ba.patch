diff --git a/tests/e2e/installable.spec.ts b/tests/e2e/installable.spec.ts
new file mode 100644
index 0000000..a795fc2
--- /dev/null
+++ b/tests/e2e/installable.spec.ts
@@ -0,0 +1,33 @@
+import { expect, test } from '@playwright/test';
+
+// Tablette ou téléphone : l’icône de l’écran d’accueil ouvre Cornelius en plein écran.
+test('le miroir s’installe en plein écran : manifeste, icônes et balises iPad', async ({
+  page,
+}) => {
+  await page.goto('/');
+  await expect(page.locator('link[rel="manifest"]')).toHaveAttribute(
+    'href',
+    '/manifest-miroir.webmanifest',
+  );
+  await expect(page.locator('meta[name="apple-mobile-web-app-capable"]')).toHaveAttribute(
+    'content',
+    'yes',
+  );
+  const response = await page.request.get('/manifest-miroir.webmanifest');
+  expect(response.status()).toBe(200);
+  const manifest = (await response.json()) as {
+    start_url: string;
+    display: string;
+    icons: { src: string; sizes: string; purpose: string }[];
+  };
+  expect(manifest.start_url).toBe('/');
+  expect(manifest.display).toBe('fullscreen');
+  expect(manifest.icons.map((icon) => icon.purpose)).toEqual(['any', 'any', 'maskable']);
+  for (const src of [...manifest.icons.map((icon) => icon.src), '/apple-touch-icon.png']) {
+    const icon = await page.request.get(src);
+    expect(icon.status(), src).toBe(200);
+    expect(icon.headers()['content-type']).toContain('image/png');
+  }
+  // La politique de sécurité du contenu laisse le navigateur lire le manifeste (même origine).
+  expect(response.headers()['content-security-policy'] ?? '').not.toContain('manifest-src');
+});
diff --git a/web/index.html b/web/index.html
index db3b386..1e377a7 100644
--- a/web/index.html
+++ b/web/index.html
@@ -2,10 +2,17 @@
 <html lang="fr">
   <head>
     <meta charset="UTF-8" />
-    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
     <meta name="theme-color" content="#050706" />
     <meta name="description" content="Cornelius, votre assistant miroir familial." />
     <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
+    <!-- Application installable : plein écran depuis l’icône de l’écran d’accueil (tablette, téléphone). -->
+    <link rel="manifest" href="/manifest-miroir.webmanifest" />
+    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
+    <meta name="mobile-web-app-capable" content="yes" />
+    <meta name="apple-mobile-web-app-capable" content="yes" />
+    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
+    <meta name="apple-mobile-web-app-title" content="Cornelius" />
     <title>Cornelius</title>
   </head>
   <body>
