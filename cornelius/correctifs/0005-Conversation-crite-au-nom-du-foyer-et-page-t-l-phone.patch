+function harness(options: {
+  blocked?: boolean;
+  key?: boolean;
+  script: (TextModelResponse | Error)[];
+}) {
+  const seen = {
+    requests: [] as { input: unknown[]; tools: unknown[]; instructions: string }[],
+    toolsProfile: undefined as string | null | undefined,
+    haRecognized: [] as (boolean | undefined)[],
+    invoked: [] as { name: string; profileId: string | null }[],
+    logs: [] as unknown[],
+  };
+  const script = [...options.script];
+  const model: TextModel = async (request) => {
+    seen.requests.push(structuredClone(request));
+    const next = script.shift();
+    if (!next) throw new Error('script épuisé');
+    if (next instanceof Error) throw next;
+    return next;
+  };
