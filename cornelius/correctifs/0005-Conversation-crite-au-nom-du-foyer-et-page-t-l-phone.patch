+/*
+ * Page téléphone (/telephone) : conversation écrite au nom du foyer. Textes de 17 px au moins
+ * (pas de zoom automatique d’iOS sur le champ), cibles tactiles de 48 px, encoches respectées.
+ */
+.chat-page {
+  --muted: #9baba2;
+  --accent: #dbe9c9;
+  --line: rgba(219, 233, 201, 0.16);
+  display: flex;
+  flex-direction: column;
+  height: 100vh;
+  height: 100dvh;
+  max-width: 760px;
+  margin: 0 auto;
+  padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom)
+    env(safe-area-inset-left);
+  font-size: 17px;
+  line-height: 1.45;
+  background: #050706;
+}
+.chat-page :where(p, h1, h2, dl, dd, ul) {
+  margin: 0;
+}
+.chat-page :where(button, textarea) {
+  font: inherit;
+  color: inherit;
+}
+.chat-page button {
+  min-height: 48px;
+  min-width: 48px;
+  padding: 0 18px;
+  border: 1px solid var(--line);
+  border-radius: 24px;
+  background: rgba(219, 233, 201, 0.08);
+  cursor: pointer;
+}
+.chat-page button:disabled {
+  opacity: 0.45;
+  cursor: default;
+}
+.chat-page button:focus-visible,
+.chat-page textarea:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+.chat-header {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 12px 16px;
+  border-bottom: 1px solid var(--line);
+}
+.chat-header h1 {
+  font-size: 21px;
+  font-weight: 500;
+}
+.chat-orb {
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  background: radial-gradient(circle at 35% 35%, #f2f7ea, #8fa58a 55%, #2b3a30);
+}
+.chat-scope {
+  color: var(--muted);
+  font-size: 15px;
+}
+.chat-clear {
+  margin-left: auto;
+}
+.chat-notice {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  margin: 12px 16px 0;
+  padding: 12px 14px;
+  border: 1px solid rgba(240, 190, 120, 0.45);
+  border-radius: 14px;
+  background: rgba(240, 190, 120, 0.1);
+}
+.chat-notice p {
+  flex: 1;
+}
+.chat-log {
+  flex: 1;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding: 16px;
+}
+.chat-empty {
+  color: var(--muted);
+  margin: auto 0;
+  text-align: center;
+}
+.chat-message {
+  max-width: 88%;
+  padding: 10px 14px;
+  border-radius: 18px;
+  overflow-wrap: anywhere;
+  white-space: pre-wrap;
+}
+.chat-user {
+  align-self: flex-end;
+  background: #dbe9c9;
+  color: #0b120d;
+}
+.chat-assistant {
+  align-self: flex-start;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  background: rgba(236, 238, 233, 0.07);
+  border: 1px solid var(--line);
+}
+.chat-pending {
+  color: var(--muted);
+}
+.chat-failed {
+  border-color: rgba(255, 140, 120, 0.6);
+  background: rgba(255, 140, 120, 0.1);
+}
+.chat-actions {
+  padding-left: 18px;
+  font-size: 16px;
+}
+.chat-card {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 10px 12px;
+  border-radius: 12px;
+  background: rgba(0, 0, 0, 0.35);
+  white-space: normal;
+}
+.chat-card h2 {
+  font-size: 17px;
+  font-weight: 600;
+}
+.chat-card-value {
+  font-size: 22px;
+}
+.chat-stale {
+  color: var(--muted);
+  font-weight: 400;
+}
+.chat-card dl {
+  display: grid;
+  gap: 4px;
+}
+.chat-card dl div {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+}
+.chat-card dt {
+  color: var(--muted);
+}
+.chat-card dd {
+  text-align: right;
+}
+.chat-form {
+  display: flex;
+  align-items: flex-end;
+  gap: 10px;
+  padding: 12px 16px 16px;
+  border-top: 1px solid var(--line);
+}
+.chat-label {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
+.chat-form textarea {
+  flex: 1;
+  min-height: 48px;
+  max-height: 30vh;
+  padding: 11px 14px;
+  border: 1px solid var(--line);
+  border-radius: 20px;
+  background: rgba(236, 238, 233, 0.06);
+  font-size: 17px;
+  resize: none;
+}
+.chat-form button[type='submit'] {
+  background: #dbe9c9;
+  color: #0b120d;
+  border-color: transparent;
+  font-weight: 600;
+}
