---
 perception/camera.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/perception/camera.py b/perception/camera.py
index 5890f00..b392a94 100644
--- a/perception/camera.py
+++ b/perception/camera.py
@@ -1,6 +1,7 @@
 """One capture shared by local recognition and the on-demand admin preview."""
 import hashlib
 import os
+import sys
 import threading
 import time
 import uuid
@@ -25,7 +26,9 @@ def valid_mode(mode):
 
 class Camera:
     def __init__(self, index=0, enabled=True):
-        self.backend = cv2.CAP_DSHOW if os.name == "nt" else cv2.CAP_V4L2
+        # macOS : AVFoundation ; V4L2 n’existe que sous Linux.
+        self.backend = (cv2.CAP_DSHOW if os.name == "nt"
+                        else cv2.CAP_AVFOUNDATION if sys.platform == "darwin" else cv2.CAP_V4L2)
         self.lock = threading.RLock()
         self.devices = {}
         self.selected_id = None
